--- a/tools/copy-if-change
+++ b/tools/copy-if-change
@@ -1,12 +1,14 @@
 # Like cp $1 $2, but if the files are the same, do NOTHING.
 # Status is 0 if $2 is changed, 1 otherwise.
+#
+# HarmonyOS hmdfs: does not allow overwriting existing files.
+# Always rm -f target before copying (rm succeeds, cp to new path works).

 if test -r "$2"; then
   if cmp "$1" "$2" > /dev/null; then
     echo "$2" is unchanged
   else
-    cp -f "$1" "$2"
+    rm -f "$2" && cp "$1" "$2"
   fi
 else
   cp "$1" "$2"
 fi
